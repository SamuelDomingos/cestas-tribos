generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeliveryType {
  BASKET
  CLOTHES
}

model GC {
  id     String  @id @default(uuid())
  name   String  @unique
  avatar String?
  tribe  String

  basketGoal Int @default(0)
  clothesGoal Int @default(0)

  goals      Goal[]
  deliveries Delivery[]

  @@map("gcs")
}

model Goal {
  id          String   @id @default(uuid())
  gcId        String?
  tribe       String?
  basketGoal  Int      @default(0)
  clothesGoal Int      @default(0)
  deadline    DateTime
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gc GC? @relation(fields: [gcId], references: [id])

  @@map("goals")
}

model Delivery {
  id          String       @id @default(uuid())
  memberId    String
  gcId        String
  type        DeliveryType
  quantity    Int          @default(1)
  photoUrl    String?
  notes       String?
  deliveredAt DateTime     @default(now())
  createdAt   DateTime     @default(now())

  gc     GC     @relation(fields: [gcId], references: [id])

  @@map("deliveries")
}
